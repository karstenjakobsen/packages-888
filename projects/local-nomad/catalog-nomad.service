[Unit]
Description=Catalog local Nomad server and Docker client
# Docker Desktop supplies the local socket from outside the WSL distribution.
# On a VPS this ordering applies when the native Docker unit is starting too.
After=network.target docker.service
ConditionPathExists=/var/lib/catalog-nomad/private/agent.hcl
ConditionFileNotEmpty=/var/lib/catalog-nomad/private/management.token
ConditionPathExists=|/var/lib/catalog-nomad/private/bootstrap.pending
ConditionFileNotEmpty=|/var/lib/catalog-nomad/private/data/server/raft/raft.db

[Service]
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/var/lib/catalog-nomad/private/nomad agent -config=/var/lib/catalog-nomad/private/agent.hcl
Restart=on-failure
RestartSec=5
KillMode=process
KillSignal=SIGINT
TimeoutStopSec=90
LimitNOFILE=65536
TasksMax=infinity
Delegate=yes

[Install]
WantedBy=multi-user.target

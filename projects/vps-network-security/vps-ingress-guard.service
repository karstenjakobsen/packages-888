[Unit]
Description=Owner two-address ingress security gate
DefaultDependencies=no
After=local-fs.target
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/vps-apply-ingress
ExecReload=/usr/local/sbin/vps-apply-ingress
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

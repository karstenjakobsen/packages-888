# Additional ingress gate before UFW, Tailscale and Docker filter accepts.
# Replies to host/container outbound connections and essential network control survive.
table inet vps_ingress_guard {
  set administrators {
    type ipv4_addr
    elements = { 86.52.144.219, 87.49.147.6 }
  }
  chain input {
    type filter hook input priority -10; policy drop;
    iifname "lo" counter accept
    ct state invalid counter drop
    ct direction reply ct state established,related counter accept
    ip saddr @administrators counter accept
    iifname "ens6" udp sport 67 udp dport 68 counter accept
    meta l4proto icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } counter accept
    meta l4proto ipv6-icmp icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } counter accept
    iifname "ens6" ip6 saddr fe80::/10 ip6 hoplimit 255 icmpv6 type { nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } counter accept
    counter drop
  }
  chain forward {
    type filter hook forward priority -10; policy accept;
    ct state invalid counter drop
    ct direction reply ct state established,related counter accept
    iifname { "ens6", "tailscale0" } ip saddr @administrators counter accept
    iifname { "ens6", "tailscale0" } counter drop
  }
}

{
  "checks": [
    {
      "name": "same HTTPS origin with default port",
      "command": "python3",
      "args": [
        "{skill}/scripts/check_credential_target.py",
        "{fixture}/input.json"
      ],
      "fixtures": {
        "input.json": "{\"intended_origin\":\"HTTPS://API.Example.Test:443\",\"request_url\":\"https://api.example.test/items\",\"redirects\":[\"https://API.example.test:443/next?cursor=2\"]}"
      },
      "expectedStdout": "reviewable same_https_origin\n",
      "timeoutMs": 3000
    },
    {
      "name": "cross origin on second redirect",
      "command": "python3",
      "args": [
        "{skill}/scripts/check_credential_target.py",
        "{fixture}/input.json"
      ],
      "fixtures": {
        "input.json": "{\"intended_origin\":\"HTTPS://API.Example.Test:443\",\"request_url\":\"https://api.example.test/items\",\"redirects\":[\"https://api.example.test/first\",\"https://other.example.test/second\"]}"
      },
      "expectedStdout": "blocked different_origin\n",
      "timeoutMs": 3000
    },
    {
      "name": "redirect downgrade",
      "command": "python3",
      "args": [
        "{skill}/scripts/check_credential_target.py",
        "{fixture}/input.json"
      ],
      "fixtures": {
        "input.json": "{\"intended_origin\":\"HTTPS://API.Example.Test:443\",\"request_url\":\"https://api.example.test/items\",\"redirects\":[\"http://api.example.test:443/next\"]}"
      },
      "expectedStdout": "blocked https_required\n",
      "timeoutMs": 3000
    },
    {
      "name": "alternate effective port",
      "command": "python3",
      "args": [
        "{skill}/scripts/check_credential_target.py",
        "{fixture}/input.json"
      ],
      "fixtures": {
        "input.json": "{\"intended_origin\":\"HTTPS://API.Example.Test:443\",\"request_url\":\"https://api.example.test:8443/items\",\"redirects\":[]}"
      },
      "expectedStdout": "blocked different_origin\n",
      "timeoutMs": 3000
    },
    {
      "name": "host suffix mismatch",
      "command": "python3",
      "args": [
        "{skill}/scripts/check_credential_target.py",
        "{fixture}/input.json"
      ],
      "fixtures": {
        "input.json": "{\"intended_origin\":\"HTTPS://API.Example.Test:443\",\"request_url\":\"https://api.example.test.other.test/\",\"redirects\":[]}"
      },
      "expectedStdout": "blocked different_origin\n",
      "timeoutMs": 3000
    },
    {
      "name": "userinfo rejected",
      "command": "python3",
      "args": [
        "{skill}/scripts/check_credential_target.py",
        "{fixture}/input.json"
      ],
      "fixtures": {
        "input.json": "{\"intended_origin\":\"HTTPS://API.Example.Test:443\",\"request_url\":\"https://placeholder@api.example.test/\",\"redirects\":[]}"
      },
      "expectedStdout": "blocked invalid_input\n",
      "timeoutMs": 3000
    },
    {
      "name": "ambiguous backslash rejected",
      "command": "python3",
      "args": [
        "{skill}/scripts/check_credential_target.py",
        "{fixture}/input.json"
      ],
      "fixtures": {
        "input.json": "{\"intended_origin\":\"HTTPS://API.Example.Test:443\",\"request_url\":\"https://api.example.test\\\\@other.example.test/\",\"redirects\":[]}"
      },
      "expectedStdout": "blocked invalid_input\n",
      "timeoutMs": 3000
    },
    {
      "name": "invalid port rejected",
      "command": "python3",
      "args": [
        "{skill}/scripts/check_credential_target.py",
        "{fixture}/input.json"
      ],
      "fixtures": {
        "input.json": "{\"intended_origin\":\"HTTPS://API.Example.Test:443\",\"request_url\":\"https://api.example.test:65536/\",\"redirects\":[]}"
      },
      "expectedStdout": "blocked invalid_input\n",
      "timeoutMs": 3000
    },
    {
      "name": "duplicate key rejected",
      "command": "python3",
      "args": [
        "{skill}/scripts/check_credential_target.py",
        "{fixture}/input.json"
      ],
      "fixtures": {
        "input.json": "{\"intended_origin\":\"https://api.example.test\",\"request_url\":\"https://api.example.test\",\"redirects\":[],\"redirects\":[]}"
      },
      "expectedStdout": "blocked invalid_input\n",
      "timeoutMs": 3000
    },
    {
      "name": "IPv6 canonicalization",
      "command": "python3",
      "args": [
        "{skill}/scripts/check_credential_target.py",
        "{fixture}/input.json"
      ],
      "fixtures": {
        "input.json": "{\"intended_origin\":\"https://[2001:db8::1]\",\"request_url\":\"https://[2001:0db8:0:0:0:0:0:1]:443/\",\"redirects\":[]}"
      },
      "expectedStdout": "reviewable same_https_origin\n",
      "timeoutMs": 3000
    }
  ]
}
